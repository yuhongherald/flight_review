# Host:port the browser reaches this at. Bokeh refuses a websocket from any other origin;
# `*` allows all, which is fine on a private network.
DOMAIN=localhost:5006
PORT=5006
# run.sh passes --allow-websocket-origin only on this branch, so leave it set even with no
# reverse proxy in front. It also adds --use-xheaders, which is harmless without one.
USE_PROXY="True"
